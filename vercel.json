{
  "version": 2,
  "buildCommand": "node scripts/sync_public.js",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS, PUT, DELETE" },
        { "key": "Access-Control-Allow-Headers", "value": "X-Requested-With, Content-Type, Authorization" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/board", "destination": "/public/board.html" },
    { "source": "/board.html", "destination": "/public/board.html" },
    { "source": "/remote", "destination": "/public/index.html" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/((?!api/).*)", "destination": "/public/index.html" }
  ]
}
