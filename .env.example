# ==============================================================================
# SmartBoard Remote — Environment Configuration
# ==============================================================================

# Server port (Render sets this dynamically; defaults to 3000 locally)
PORT=3000

# Environment mode (development / production)
NODE_ENV=production

# Optional: Custom path to the LibreOffice soffice binary
# Default inside Docker container: /usr/bin/soffice
# Default on Windows: C:\Program Files\LibreOffice\program\soffice.exe
LIBREOFFICE_PATH=

# ---------------------------------------------------------------------------
# PRODUCTION: FRONTEND_URL  (set this on Render)
# ---------------------------------------------------------------------------
# The origin of your Vercel frontend. Used to configure CORS on the backend.
# Accepts a comma-separated list for multiple preview deployments.
# If not set, CORS defaults to '*' (allows all origins — safe for local dev).
#
# Example:
#   FRONTEND_URL=https://smart-board-nu.vercel.app
FRONTEND_URL=

# ---------------------------------------------------------------------------
# PRODUCTION: BACKEND_URL  (set this on Vercel)
# ---------------------------------------------------------------------------
# The origin of your Render backend. Used by the Vercel /api/config endpoint
# and injected into frontend HTML at build time.
#
# Example:
#   BACKEND_URL=https://smartboard-remote.onrender.com
BACKEND_URL=

# ---------------------------------------------------------------------------
# PERSISTENT GOOGLE DRIVE STORAGE (Google OAuth 2.0 - Personal 15GB Quota)
# Set these on Render so presentations are stored under your personal Google
# account quota and survive all container restarts and redeployments.
# (If not set, backend automatically falls back to local disk storage for local dev).
# ---------------------------------------------------------------------------
#
# 1. GOOGLE_DRIVE_FOLDER_ID: The ID of your Google Drive folder
#    Your folder ID: 1EDu-v1jwhKUC91vIj_CVeCD_HooSvepg
GOOGLE_DRIVE_FOLDER_ID=1EDu-v1jwhKUC91vIj_CVeCD_HooSvepg

# 2. GOOGLE_CLIENT_ID: Your Google Cloud OAuth 2.0 Client ID
#    Example: xxxxx-xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# 3. GOOGLE_CLIENT_SECRET: Your Google Cloud OAuth 2.0 Client Secret
#    Example: GOCSPX-xxxxxxxxxxxx
GOOGLE_CLIENT_SECRET=

# 4. GOOGLE_REFRESH_TOKEN: The OAuth 2.0 Refresh Token for your Google account
#    Example: 1//0gxxxxxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=
